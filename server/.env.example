PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=zetech_hostel
# Local development only; production enables verified TLS by default.
DB_SSL=false
# Optional CA certificate PEM for verified TLS connections. In Render, set the
# full PEM contents as DB_SSL_CA; literal \n sequences are expanded automatically.
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----

JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
ADMIN_SECRET=change_this_to_a_strong_admin_secret

# CORS — comma-separated list of allowed frontend origins
# Add additional frontend origins here; the production Netlify app is allowed by default.
# e.g. ALLOWED_ORIGINS=https://preview.example.net,https://localhost.example.net
# For local dev leave as-is or add http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# Payments use Safaricom sandbox unless this is explicitly set to production.
# Production requires live Daraja credentials and a publicly reachable HTTPS callback URL.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_CALLBACK_URL=https://your-domain.com/api/payments/callback

SMTP_EMAIL=your_gmail@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# Login OTPs use Brevo transactional email. The sender email must be verified in Brevo.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=your_verified_sender@example.com
# BREVO_SENDER_NAME=Zetech Hostel

# Render keep-alive ping URL (production only)
# RENDER_URL=https://your-service.onrender.com
